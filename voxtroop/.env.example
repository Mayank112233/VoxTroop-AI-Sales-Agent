# Local-only defaults. Copy this file to .env and generate two distinct secrets.
MOCK_AI_MODE=true
DATA_DIR=runtime
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_TOKEN=
WIDGET_SECRET=
TENANT_TOKEN_HASHES={}

# Optional live chat and embeddings.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=

# Optional OpenAI voice.
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
